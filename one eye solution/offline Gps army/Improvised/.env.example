# Offline device configuration
# Copy this file to .env and fill in the values.
# Vehicle number / driver name are entered in the web UI (Vehicle tab).

# Password for Settings > Factory Reset
# DELETE_DEVICE_PASSWORD=change_me

# Head-pose distraction (LookingDown / LookingAway)
# LOOKDOWN_ENABLED=1
# LOOKDOWN_PITCH_THRESHOLD=20
# LOOKAWAY_YAW_THRESHOLD=25
# LOOKDOWN_FRAMES=8
# LOOKAWAY_FRAMES=8
# LOOKAWAY_ONE_EYE_SECONDS=3
# LOOKDOWN_MISS_TOLERANCE=2

# PhoneCall: Hands idle scan interval (s) and release time (s).
# Alert delay / buzz duration / ear distance are set in the Settings page.
# HANDS_SCAN_INTERVAL=0.4
# PHONE_RELEASE_SECONDS=1.0
# CAMERA_FPS=15

# SQLite Database Path (default: ./data/blinksmart.db)
# DB_PATH=/home/pi/facial-tracker-firmware/data/blinksmart.db

# USB stick offline export (usb_export.py + blinksmart-usb-export@.service)
# EVENTS_DIR=/home/pi/facial-tracker-firmware/images/events
# USB_EXPORT_MOUNT_POINT=/mnt/blinksmart-usb
# USB_EXPORT_MARKER=BLINKSMART_EXPORT
# USB_EXPORT_PREFIX=blinksmart_export
# Delete only checksum-verified event files after the USB copy is flushed.
# USB_EXPORT_DELETE_EVENTS=1
# Sample snapshots per event type in Vehicle_Report.pdf
# USB_REPORT_IMAGES_PER_TYPE=4

# Provisioning UI — open at http://copilot.local:5000 (requires setup/copilot-local-hostname.sh)
# DEVICE_LOCAL_HOST=copilot
# PROVISIONING_UI_PORT=5000
